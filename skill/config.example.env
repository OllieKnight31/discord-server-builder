# Settings for the discord-server-builder skill.
# install.sh copies this file to config.env. Fill in config.env, never this example.
# Keep config.env private: anyone holding the token can control your bot.

# The bot token: Discord Developer Portal, your application, Bot, Reset Token.
DISCORD_BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE

# The server to build in: right-click the server icon in Discord, Copy Server ID
# (switch on Developer Mode in Settings, Advanced first). 17 to 20 digits.
DISCORD_GUILD_ID=PASTE_YOUR_SERVER_ID_HERE
